{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompanyInfo",
  "description": "倍斯特公司基础信息数据Schema",
  "type": "object",
  "required": ["name", "founded_year", "industry", "products"],
  "properties": {
    "name": { "type": "string", "description": "公司名称" },
    "founded_year": { "type": "integer", "minimum": 2000, "maximum": 2030 },
    "industry": { "type": "string", "enum": ["共享充电宝", "充电柜", "消费电子", "新能源"] },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "capacity", "specs"],
        "properties": {
          "name": { "type": "string" },
          "capacity": { "type": "string" },
          "specs": { "type": "object" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "event"],
        "properties": {
          "year": { "type": "integer" },
          "event": { "type": "string" }
        }
      }
    }
  }
}