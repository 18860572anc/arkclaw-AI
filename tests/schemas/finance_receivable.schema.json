{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinanceReceivableSchema",
  "description": "倍用心-财务与收款数据域Schema",
  "type": "object",
  "properties": {
    "outbound_detail": {
      "type": "object",
      "required": ["outbound_no", "order_no", "customer", "product", "qty", "total_amount", "outbound_date"],
      "properties": {
        "outbound_no": {"type": "string"},
        "order_no": {"type": "string"},
        "customer": {"type": "string"},
        "product": {"type": "string"},
        "qty": {"type": "integer", "minimum": 1},
        "unit_price": {"type": "number", "minimum": 0},
        "total_amount": {"type": "number", "minimum": 0},
        "outbound_date": {"type": "string"},
        "warehouse": {"type": "string"}
      }
    },
    "payment_record": {
      "type": "object",
      "required": ["payment_no", "customer", "amount", "payment_date", "payment_method", "status"],
      "properties": {
        "payment_no": {"type": "string"},
        "customer": {"type": "string"},
        "amount": {"type": "number", "minimum": 0},
        "payment_date": {"type": "string"},
        "payment_method": {"type": "string", "enum": ["银行转账", "承兑汇票", "现金", "支票"]},
        "related_invoice": {"type": "string"},
        "status": {"type": "string", "enum": ["confirmed", "pending", "failed"]}
      }
    },
    "expense": {
      "type": "object",
      "required": ["expense_no", "department", "category", "amount", "expense_date", "status"],
      "properties": {
        "expense_no": {"type": "string"},
        "department": {"type": "string"},
        "category": {"type": "string"},
        "amount": {"type": "number", "minimum": 0},
        "expense_date": {"type": "string"},
        "status": {"type": "string", "enum": ["approved", "pending", "rejected"]},
        "remark": {"type": "string"}
      }
    },
    "labor_hours": {
      "type": "object",
      "required": ["department", "period", "total_hours", "headcount"],
      "properties": {
        "department": {"type": "string"},
        "period": {"type": "string"},
        "total_hours": {"type": "number", "minimum": 0},
        "regular_hours": {"type": "number", "minimum": 0},
        "overtime_hours": {"type": "number", "minimum": 0},
        "headcount": {"type": "integer", "minimum": 1},
        "avg_hours_per_person": {"type": "number", "minimum": 0}
      }
    }
  }
}