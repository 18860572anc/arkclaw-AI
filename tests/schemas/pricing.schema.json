{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PricingSchema",
  "description": "定价数据Schema",
  "type": "object",
  "required": [
    "base_prices",
    "quotes"
  ],
  "properties": {
    "base_prices": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "product_id",
          "unit_price",
          "qty",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}