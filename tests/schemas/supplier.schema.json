{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupplierSchema",
  "description": "供应商数据Schema（含倍用心接口扩展字段）",
  "type": "object",
  "required": [
    "suppliers"
  ],
  "properties": {
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "supplier_code",
          "supplier_name",
          "material_type",
          "rating",
          "delivery_punctuality_rate"
        ],
        "properties": {
          "supplier_code": {"type": "string"},
          "supplier_name": {"type": "string"},
          "material_type": {"type": "string"},
          "rating": {"type": "number", "minimum": 0, "maximum": 5},
          "delivery_punctuality_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "price_level": {"type": "string", "enum": ["低", "中等", "偏高", "高"]},
          "cooperation_years": {"type": "integer", "minimum": 0},
          "certifications": {"type": "array", "items": {"type": "string"}},
          "contact_person": {"type": "string"},
          "contact_phone": {"type": "string"},
          "bank_info": {
            "type": "object",
            "properties": {
              "bank": {"type": "string"},
              "account": {"type": "string"}
            }
          },
          "payment_terms": {"type": "string"}
        }
      }
    }
  }
}